#!/usr/bin/env bash
# Test stub for the claude CLI: records argv, stdin presence and the env the launcher set.
if [ -n "${FAKE_CLAUDE_LOG:-}" ]; then
  {
    printf 'ARG:%s\n' "$@"
    printf 'ENV:ANTHROPIC_BASE_URL=%s\n' "${ANTHROPIC_BASE_URL:-}"
    printf 'ENV:ANTHROPIC_MODEL=%s\n' "${ANTHROPIC_MODEL:-}"
    printf 'ENV:KEYSET=%s\n' "$([ -n "${ANTHROPIC_AUTH_TOKEN:-}" ] && echo yes || echo no)"
    printf 'ENV:MY_CLAUDE_KEY=%s\n' "${MY_CLAUDE_KEY:-unset}"
  } > "$FAKE_CLAUDE_LOG"
fi
case "${1:-}" in
  --version) echo "9.9.9 (fake)"; exit 0 ;;
  --help) echo "  --settings <file-or-json>"; exit 0 ;;
esac
exit 0
